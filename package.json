{
  "name": "swop-mcp",
  "version": "0.2.2",
  "description": "Swop MCP server: sell to people and AI agents, paid in USDC (products, storefronts, x402 links, checkout) plus swop.id identity",
  "type": "module",
  "main": "dist/http.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/http.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "start": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-endpoints.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "viem": "^2.56.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
